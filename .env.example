# ==============================================================================
# AI QA Testing Agent — Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real configuration.
# Never commit your actual .env file to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (Docker Compose & Standalone)
# For Docker Compose, the database service is named 'postgres' on port 5432.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=ai_qa_agent
DATABASE_URL=postgresql://postgres:replace_with_a_strong_database_password@postgres:5432/ai_qa_agent

# AI Engine (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# Platform Security & Authentication
# Min 16-character secret key for CI/CD pipelines and automated service access
PLATFORM_API_KEY=replace_with_a_random_key_at_least_16_characters

# Cookie Signing Secret (minimum 32 characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace_with_a_secure_cookie_signing_secret_at_least_32_characters

# Secret Storage Encryption (AES-256-GCM 32-byte Base64 key)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your_32_byte_base64_encryption_key_here

# Network & SSRF Security
# ALWAYS set to false in production. When false, requests to private/loopback/cloud metadata IPs are blocked.
ALLOW_PRIVATE_TARGETS=false

# Allowed CORS Origins (comma-separated list for Fastify CORS)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Dashboard Web Client (Vite Frontend)
VITE_API_URL=http://localhost:3000
DASHBOARD_PORT=5173

# Migrations & Automation Controls
RUN_MIGRATIONS=true

# Target App Fixtures (StockFlow Reference Target)
STOCKFLOW_BASE_URL=https://stockflow-vert-two.vercel.app
STOCKFLOW_TEST_EMAIL=
STOCKFLOW_TEST_PASSWORD=

# ==============================================================================
# Task 12 — Background Jobs & Worker Queue Configuration
# Default is PostgreSQL-backed queue ('FOR UPDATE SKIP LOCKED').
# Set USE_REDIS_QUEUE=true only for distributed multi-node horizontal worker clusters.
# ==============================================================================
USE_REDIS_QUEUE=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ==============================================================================
# Task 13 — S3-Compatible Artifact Storage (MinIO Local / AWS S3 Production)
# Options for STORAGE_PROVIDER: 'local' (disk storage) or 's3' (MinIO / AWS S3)
# Automatic fallback to local disk occurs if S3/MinIO is unreachable.
# ==============================================================================
STORAGE_PROVIDER=local
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ai-qa-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniopassword123
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ==============================================================================
# Task 14 — Logging & Observability
# Log levels: 'debug', 'info', 'warn', 'error'. Sensitive tokens are automatically redacted.
# ==============================================================================
LOG_LEVEL=info
